# CONTEXTE ÉTUDIANT : PRÉPARATION | modèle à conserver sans vraies valeurs privées
# À PRÉPARER / ADAPTER : Générer votre .env selon le support ; CHANGE_ME n’est pas un mot de passe à utiliser.
# CONTRÔLE ATTENDU : Vérifier l’exclusion de .env par Git sans afficher son contenu.
#
# Copier/générer .env selon le guide de préparation ; ne pas commiter .env.
POSTGRES_USER=campus
POSTGRES_DB=campus
# Placeholder uniquement : générer un secret hexadécimal pour le TP.
# Changer cette valeur ne change pas le mot de passe d’une DB déjà initialisée.
POSTGRES_PASSWORD=CHANGE_ME
# Remplacer CHANGE_ME par le même secret hexadécimal que ci-dessus.
# Cette adresse cible Compose/Kubernetes. Pour l’API sur le poste, remplacer
# l’hôte db par 127.0.0.1 dans le terminal ; pour les tests utiliser campus_test.
DATABASE_URL=postgresql+psycopg://campus:CHANGE_ME@db:5432/campus
